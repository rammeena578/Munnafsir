<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Trade with munaaf | Telegram</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Arial, Helvetica, sans-serif;
            overflow: hidden;

            /* Animated background */
            background: linear-gradient(
                120deg,
                #0f172a,
                #123c3c,
                #1e293b,
                #064e3b
            );
            background-size: 400% 400%;
            animation: backgroundMove 12s ease infinite;
        }

        @keyframes backgroundMove {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        .container {
            width: 92%;
            max-width: 420px;
            padding: 30px 22px;
            text-align: center;

            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 25px;

            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);

            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
        }

        /* Profile image */
        .profile {
            width: 125px;
            height: 125px;
            object-fit: cover;
            border-radius: 50%;

            border: 4px solid #ffd43b;

            box-shadow:
                0 0 0 5px rgba(255, 212, 59, 0.12),
                0 10px 30px rgba(0, 0, 0, 0.4);

            margin-bottom: 18px;
        }

        .channel-name {
            color: #ffffff;
            font-size: 25px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .subtitle {
            color: rgba(255,255,255,0.78);
            font-size: 14px;
            line-height: 1.5;
            margin-bottom: 22px;
        }

        .timer-box {
            color: #ffffff;
            font-size: 14px;
            margin-bottom: 15px;
        }

        #timer {
            display: inline-block;
            min-width: 30px;
            font-size: 20px;
            font-weight: bold;
            color: #ffd43b;
        }

        /* Telegram button */
        .telegram-btn {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;

            width: 100%;
            min-height: 58px;

            background: #ffd43b;
            color: #111827;

            text-decoration: none;
            border-radius: 15px;

            font-size: 16px;
            font-weight: 700;

            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);

            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease,
                background 0.25s ease;

            animation: buttonPulse 2s infinite;
        }

        .telegram-btn:hover {
            transform: translateY(-3px);
            background: #ffe477;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
        }

        .telegram-btn:active {
            transform: scale(0.97);
        }

        /* Telegram logo */
        .telegram-logo {
            width: 30px;
            height: 30px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #229ED9;
            color: white;

            border-radius: 50%;

            font-size: 17px;

            animation: logoZoom 1.4s ease-in-out infinite;
        }

        @keyframes logoZoom {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.18);
            }
        }

        @keyframes buttonPulse {
            0%, 100% {
                box-shadow: 0 10px 25px rgba(0,0,0,0.25);
            }

            50% {
                box-shadow: 0 10px 30px rgba(255,212,59,0.35);
            }
        }

        .small-text {
            color: rgba(255,255,255,0.55);
            font-size: 11px;
            margin-top: 18px;
            line-height: 1.5;
        }

        .loading {
            width: 100%;
            height: 4px;
            margin-top: 20px;
            background: rgba(255,255,255,0.15);
            border-radius: 10px;
            overflow: hidden;
        }

        .loading-bar {
            height: 100%;
            width: 100%;
            background: #ffd43b;
            transform-origin: left;
            animation: countdown 20s linear forwards;
        }

        @keyframes countdown {
            from {
                transform: scaleX(1);
            }

            to {
                transform: scaleX(0);
            }
        }

        @media (max-width: 480px) {

            .container {
                padding: 25px 18px;
            }

            .profile {
                width: 110px;
                height: 110px;
            }

            .channel-name {
                font-size: 22px;
            }

            .telegram-btn {
                min-height: 55px;
                font-size: 15px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- Profile Image -->
        <img
            src="profile.jpg"
            alt="Trade with munaaf"
            class="profile"
        >

        <!-- Channel Name -->
        <div class="channel-name">
            𝗧𝗿𝗮𝗱𝗲 𝘄𝗶𝘁𝗵 𝗺𝘂𝗻𝗮𝗮𝗳
        </div>

        <div class="subtitle">
            Stock Market • Share Market • Trading
            <br>
            Join our free Telegram channel
        </div>

        <!-- Countdown -->
        <div class="timer-box">
            Redirecting to Telegram in
            <span id="timer">20</span>
            seconds
        </div>

        <!-- Telegram Button -->
        <a
            href="https://t.me/+VzW7Xq8nmJwxMjg1"
            class="telegram-btn"
            id="telegramButton"
        >
            <span class="telegram-logo">
                ➤
            </span>

            <span>
                𝗝𝗼𝗶𝗻 𝗢𝘂𝗿 𝗙𝗿𝗲𝗲 𝗧𝗲𝗹𝗲𝗴𝗿𝗮𝗺
            </span>
        </a>

        <!-- Progress -->
        <div class="loading">
            <div class="loading-bar"></div>
        </div>

        <div class="small-text">
            Free access • Trading updates • Market information
        </div>

    </div>


    <script>

        // Telegram link
        const telegramURL =
            "https://t.me/+VzW7Xq8nmJwxMjg1";

        // Starting countdown
        let seconds = 20;

        const timer =
            document.getElementById("timer");

        // Countdown every second
        const countdown = setInterval(function () {

            seconds--;

            timer.textContent = seconds;

            if (seconds <= 0) {

                clearInterval(countdown);

                // Automatic Telegram redirect
                window.location.href = telegramURL;

            }

        }, 1000);


        // Immediate button click
        document
            .getElementById("telegramButton")
            .addEventListener("click", function () {

                window.location.href = telegramURL;

            });

    </script>

</body>
</html>
